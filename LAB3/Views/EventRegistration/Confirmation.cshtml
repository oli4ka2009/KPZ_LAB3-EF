@{
    ViewData["Title"] = "Підтвердження реєстрації";
}

<h2>Реєстрація успішна!</h2>
<p>Дякуємо за реєстрацію на подію.</p>

@if (ViewBag.DocumentUrl != null)
{
        <p>
            <strong>Ваш документ доступний за наступним посиланням:</strong>
            <a href="@ViewBag.DocumentUrl" target="_blank">Переглянути документ</a>
        </p>
}
else
{
        <p>На жаль, не вдалося створити документ.</p>
}
